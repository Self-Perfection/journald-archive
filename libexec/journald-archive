#!/bin/bash
set -euo pipefail

# shellcheck source=/dev/null
. /etc/default/journald-archive

: "${ARCHIVE_MOUNT:?ARCHIVE_MOUNT not set in /etc/default/journald-archive}"

# Grace period (minutes): a rotated file is archived only once it is older
# than this. Larger values keep more recent history in the fast hot tier;
# it also avoids racing journald right after rotation. Defaults to 30 to match
# the timer interval, so a file is archived only after surviving a full cycle.
GRACE_MINUTES="${GRACE_MINUTES:-30}"
case "$GRACE_MINUTES" in
    ''|*[!0-9]*)
        echo "GRACE_MINUTES must be a non-negative integer (got '$GRACE_MINUTES')" >&2
        exit 1
        ;;
esac

if ! mountpoint -q -- "$ARCHIVE_MOUNT"; then
    echo "$ARCHIVE_MOUNT is not a mount point — aborting to avoid writing onto rootfs" >&2
    exit 1
fi

# Pull one field out of `btrfs filesystem usage -b` (raw bytes). "Free
# (estimated)" accounts for chunk/metadata overhead better than df does.
btrfs_usage_field() {
    btrfs filesystem usage -b "$ARCHIVE_MOUNT" 2>/dev/null \
        | grep -oP "$1"':\s+\K[0-9]+' | head -1
}

# Free margin (MiB) to keep available so incoming journals have room without
# hitting ENOSPC. Falls back to ~1/16 of the archive size if unset (e.g. a
# config predating the option that has not been migrated yet).
TOTAL_BYTES=$(btrfs_usage_field 'Device size' || true)
FREE_MARGIN_MIB="${FREE_MARGIN_MIB:-}"
if [ -z "$FREE_MARGIN_MIB" ]; then
    FREE_MARGIN_MIB=$(( ${TOTAL_BYTES:-0} / 1048576 / 16 ))
fi
case "$FREE_MARGIN_MIB" in
    ''|*[!0-9]*)
        echo "FREE_MARGIN_MIB must be a non-negative integer (got '$FREE_MARGIN_MIB')" >&2
        exit 1
        ;;
esac
margin_bytes=$(( FREE_MARGIN_MIB * 1048576 ))

# Never let a misconfigured margin wipe the whole archive: cap it at half the
# device, otherwise the eviction loop below could delete everything chasing an
# unreachable target.
if [ -n "${TOTAL_BYTES:-}" ] && [ "$margin_bytes" -gt $(( TOTAL_BYTES / 2 )) ]; then
    echo "journald-archive: FREE_MARGIN_MIB (${FREE_MARGIN_MIB} MiB) exceeds half the archive; capping" >&2
    margin_bytes=$(( TOTAL_BYTES / 2 ))
fi

# Which files we consider archivable journals, used by BOTH the eviction and
# the move loop below (keep them in sync: archiving a shape we never evict
# would fill the archive with files eviction can't reclaim).
#
# journald names a rotated journal "<prefix>@<seq>-<realtime>.journal". A file
# it had to dispose of — corrupt, or written by a version whose features it
# cannot handle — is renamed to "<prefix>@<id>-<id>.journal~" and left in
# place. Both are sealed: journald only ever appends to "<prefix>.journal",
# which has no '@' and is what the '@' in the pattern keeps out. journalctl
# reads .journal~ files like any other, so they carry real history and belong
# in the archive rather than being left for journald's vacuum to delete.
JOURNAL_MATCH=( -name '*@*.journal' -o -name '*@*.journal~' )

MACHINE_ID=$(cat /etc/machine-id)
SRC="/var/log/journal/$MACHINE_ID"
DST="$ARCHIVE_MOUNT/$MACHINE_ID"

[ -d "$SRC" ] || exit 0

if [ ! -d "$DST" ]; then
    install -d -m 2755 -o root -g systemd-journal "$DST"
fi

# Eviction: drop just enough of the oldest archived journals to restore
# FREE_MARGIN_MIB of free space.
#
# The deletion set is PLANNED UP FRONT and deleted in one go — there is no
# "delete one, re-read free space, repeat" loop. Such a loop trusts the
# filesystem counter to grow after each delete, and it does not when files are
# still open: unlinking an open file frees nothing until it is closed. A
# long-running journalctl over the combined view opens every archived file
# (journalctl opens all files in the directory, whatever its time filter, and
# mergerfs holds the underlying archive files open on its behalf), so the old
# loop never saw free space grow and deleted the entire archive. Planning first
# bounds every run to the files that genuinely had to go, however the counter
# behaves; if the estimate falls short, the next timer run plans again from the
# new free space.
#
# Planning needs each file's on-disk (compressed) size. st_size/st_blocks/du
# report the uncompressed size on btrfs, so:
#   - with compsize (btrfs-compsize, Recommends:) we read the real per-file
#     disk usage;
#   - without it, we scale st_size by the archive's overall ratio (filesystem
#     "Used" / sum of st_size). That is an estimate: it can fall short when the
#     oldest files compress worse than average, which only defers the rest of
#     the eviction to the next run.
#
# Open files: if any file in the plan is open, nothing is deleted this run —
# deleting it would free nothing now, and since free space would not grow, the
# next run would plan (and delete) the next batch too, draining the archive one
# deficit per timer tick for as long as the reader lives. `fuser` matches by
# device and inode (so other paths to the same file, e.g. bind mounts, count
# too) and also sees files mapped without an open fd. Eviction is not shifted
# to newer, closed files, to keep it oldest-first. The next timer run retries
# once the reader is gone; until then new journals wait in the hot tier (moves
# that hit ENOSPC are retried).

# On-disk bytes of one file per compsize, into $REPLY; empty for "unknown".
# A global instead of $(...) around the function saves a subshell per file.
# compsize exits 1 on a file with no extents (empty), which occupies nothing.
compsize_bytes() {
    local out t du
    REPLY=
    out=$(compsize -b -- "$1" 2>/dev/null) || { REPLY=0; return 0; }
    while read -r t _ du _; do
        if [ "$t" = TOTAL ]; then REPLY=$du; return 0; fi
    done <<<"$out"
}

# The plan rests on a single reading of free space, so settle the accounting
# first: btrfs counts writes and frees only once their transaction commits, and
# a stale (too high) reading would under-plan.
btrfs filesystem sync "$ARCHIVE_MOUNT" >/dev/null
free=$(btrfs_usage_field 'Free \(estimated\)')
if [ -z "$free" ]; then
    echo "journald-archive: could not read archive free space; skipping eviction" >&2
elif [ "$free" -lt "$margin_bytes" ]; then
    deficit=$(( margin_bytes - free ))

    # Oldest first: "<mtime> <st_size> <path>". Captured whole, not piped into
    # head: under pipefail an early-closing reader SIGPIPEs sort and set -e
    # aborts the script (the 0.3.4 bug).
    listing=$(find "$ARCHIVE_MOUNT" -type f \( "${JOURNAL_MATCH[@]}" \) \
              -printf '%T@ %s %p\n' 2>/dev/null | sort -n)

    use_compsize=
    command -v compsize >/dev/null && use_compsize=1
    if [ -z "$use_compsize" ]; then
        # Overall ratio in parts per million (keeps the integer math within
        # 64 bits up to multi-TiB archives).
        used=$(btrfs_usage_field '^\s*Used')
        apparent=$(awk '{ s += $2 } END { printf "%.0f\n", s }' <<<"$listing")
        ratio_ppm=1000000
        if [ -n "$used" ] && [ "$apparent" -gt 0 ]; then
            ratio_ppm=$(( used * 1000000 / apparent ))
        fi
    fi

    plan=()
    planned=0
    while [ "$planned" -lt "$deficit" ] && read -r _ size path; do
        [ -n "$path" ] || continue
        est=
        if [ -n "$use_compsize" ]; then compsize_bytes "$path"; est=$REPLY; fi
        [ -n "$est" ] || est=$(( size * ${ratio_ppm:-1000000} / 1000000 ))
        plan+=("$path")
        planned=$(( planned + est ))
    done <<<"$listing"

    if [ "${#plan[@]}" -gt 0 ] && ! command -v fuser >/dev/null; then
        # Without fuser we cannot tell whether the plan is open, and deleting
        # open files is exactly what drains the archive. Fail safe: skip.
        echo "journald-archive: fuser (psmisc) not found; cannot check whether" \
             "journals due for eviction are open, so eviction is skipped" >&2
    elif [ "${#plan[@]}" -gt 0 ]; then
        # fuser prints the PIDs on stdout (access letters and names go to
        # stderr) and exits 0 if any of the files is in use. No "--": psmisc
        # fuser does not support it ("No process specification given"); the
        # paths are absolute, so none can look like an option.
        if pids=$(fuser "${plan[@]}" 2>/dev/null); then
            read -ra pid_list <<<"$pids"
            holders=$(IFS=,; ps -o pid=,comm= -p "${pid_list[*]}" 2>/dev/null \
                      | awk '{ printf "%s%s (PID %s)", n++ ? ", " : "", $2, $1 }')
            echo "journald-archive: eviction postponed: journal(s) due for" \
                 "eviction are open, so deleting them would free nothing." \
                 "Held by: ${holders:-${pid_list[*]}} (mergerfs means a journalctl-all" \
                 "query, e.g. a long one or -f, still running)" >&2
        else
            rm -f -- "${plan[@]}"
            btrfs filesystem sync "$ARCHIVE_MOUNT" >/dev/null
        fi
    fi
fi

# Move sealed journals (rotated, or disposed-of '.journal~' ones — see
# JOURNAL_MATCH; never the active system.journal) older than the grace period
# into the archive. A failed move is almost always ENOSPC; clean up any partial
# copy and retry next run rather than leaving a truncated journal that
# journalctl would choke on.
#
# Oldest first (by mtime): if not everything fits this run, the leftovers stay
# in the hot tier, where journald evicts the oldest first — so archive the
# most-at-risk (oldest) files before journald can drop them.
while IFS= read -r -d '' f; do
    base=${f##*/}
    if ! mv -n -- "$f" "$DST/$base"; then
        rm -f -- "$DST/$base"
        echo "journald-archive: could not archive $base (likely out of space); will retry" >&2
    fi
done < <(find "$SRC" -maxdepth 1 -type f \( "${JOURNAL_MATCH[@]}" \) \
             -mmin +"$GRACE_MINUTES" -printf '%T@\t%p\0' | sort -zn | cut -z -f2-)
